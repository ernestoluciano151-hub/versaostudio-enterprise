// =============================================================================
// VersaoStudio Enterprise — VersaoDigital OS
// Schema Prisma completo — Single Source of Truth do modelo de dados
// =============================================================================
// REGRAS INVIOLÁVEIS
//   1. Dinheiro: SEMPRE Int em menor unidade (cêntimos/kwanza-cêntimo) + currency.
//      NUNCA Float/Decimal implícito. amountMinor = 150000 -> 1.500,00 AOA
//   2. Multi-tenant desde o início: organizationId em todas as tabelas de negócio.
//   3. Ledger e AuditLog são append-only (revogar UPDATE/DELETE ao nível da BD).
//   4. Soft delete via deletedAt onde há valor histórico; hard delete só em GDPR/purga.
//   5. Todo o índice de leitura frequente é explícito. Nada fica ao acaso.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [pgcrypto, btree_gist, pg_trgm]
}

// =============================================================================
// 1. IDENTITY & ACCESS
// =============================================================================

model Organization {
  id           String   @id @default(cuid())
  name         String
  legalName    String?
  taxId        String? // NIF
  slug         String   @unique
  locale       String   @default("pt-AO")
  timezone     String   @default("Africa/Luanda")
  baseCurrency String   @default("AOA")
  address      String?
  city         String?  @default("Luanda")
  country      String   @default("AO")
  phone        String?
  email        String?
  logoUrl      String?
  settings     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   Membership[]
  invitations   Invitation[]
  clients       Client[]
  leads         Lead[]
  bookings      Booking[]
  invoices      Invoice[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]
  services      Service[]
  priceLists    PriceList[]
  resources     Resource[]
  deliverables  Deliverable[]
  campaigns     MarketingCampaign[]
  contentPlans  ContentPlan[]
  saasProjects  SaaSProject[]
  seoPages      SEOPage[]
  redirects     Redirect[]
  auditLogs     AuditLog[]
  domainEvents  DomainEvent[]

  @@index([slug])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  phone         String?
  image         String?
  passwordHash  String? // argon2id; null quando só OAuth
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String? // encriptado at-rest (AES-256-GCM, MFA_ENCRYPTION_KEY)
  mfaVerifiedAt DateTime? // última verificação TOTP bem-sucedida
  passwordChangedAt  DateTime? // invalida sessões anteriores
  mustChangePassword Boolean @default(false) // onboarding e reposições
  locale        String    @default("pt-AO")
  lastLoginAt   DateTime?
  lockedUntil   DateTime?
  failedLogins  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  memberships Membership[]
  accounts    Account[]
  sessions    Session[]
  clientLinks ClientUser[]
  auditLogs   AuditLog[]
  activities  Activity[]
  assignedJobs ProductionJob[] @relation("JobAssignee")
  projectAssignments ProjectAssignment[]
  mfaBackupCodes MfaBackupCode[]
  authEvents     AuthEvent[]

  @@index([email])
  @@index([deletedAt])
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role
  permissions    String[]     @default([]) // overrides granulares
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId, role])
}

// 11 papéis — política em docs/security/rbac.md, decisão em ADR-009.
// ATENÇÃO: EDITOR foi REDEFINIDO (era conteúdo, agora é pós-produção).
// O papel de conteúdo passou a CONTENT_MANAGER. Migrar utilizadores ANTES de aplicar.
enum Role {
  OWNER
  ADMIN
  FINANCE_MANAGER
  PRODUCER
  PHOTOGRAPHER
  VIDEOGRAPHER
  EDITOR
  CONTENT_MANAGER
  SALES
  STAFF
  CLIENT
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           Role
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String
  createdAt      DateTime     @default(now())

  @@index([organizationId, email])
}

// NextAuth v5 — sessões em base de dados
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id            String    @id @default(cuid())
  sessionToken  String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires       DateTime
  mfaVerifiedAt DateTime? // null = sessão NÃO elevada; bloqueia todo o /admin
  lastActiveAt  DateTime  @default(now()) // expiração por inatividade
  ip            String?
  userAgent     String?

  @@index([userId])
  @@index([expires])
}

// Códigos de recuperação MFA — guardados como hash argon2id, uso único
model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

// APPEND-ONLY. Sem UPDATE. Sem DELETE. Distinto de AuditLog: muito mais frequente,
// precisa de índice por e-mail (tentativas em contas inexistentes não têm userId).
model AuthEvent {
  id        String        @id @default(cuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String? // tentativa em conta inexistente
  type      AuthEventType
  success   Boolean
  method    AuthMethod?
  ip        String?
  userAgent String?
  reason    String?
  at        DateTime      @default(now())

  @@index([userId, at])
  @@index([email, at])
  @@index([type, at])
}

enum AuthEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  LOGOUT_ALL
  MFA_VERIFIED
  MFA_FAILED
  MFA_ENABLED
  MFA_DISABLED
  BACKUP_CODE_USED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET
  PASSWORD_CHANGED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  SESSION_REVOKED
  MAGIC_LINK_SENT
  MAGIC_LINK_USED
  ROLE_CHANGED
  ACCESS_DENIED // tentativa de acesso a rota protegida sem sessão válida
}

enum AuthMethod {
  PASSWORD
  MAGIC_LINK
  TOTP
  BACKUP_CODE
  OAUTH
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================================================
// 2. CRM
// =============================================================================

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  phone          String?
  company        String?
  message        String?      @db.Text
  status         LeadStatus   @default(NEW)
  score          Int          @default(0)
  serviceInterest String?
  estimatedValueMinor Int?
  currency       String       @default("AOA")

  sourceId String?
  source   LeadSource? @relation(fields: [sourceId], references: [id])

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  referrer    String?
  landingPage String?

  campaignId String?
  campaign   MarketingCampaign? @relation(fields: [campaignId], references: [id])

  convertedClientId String?
  convertedClient   Client? @relation(fields: [convertedClientId], references: [id])
  convertedAt       DateTime?

  ownerId   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  activities  Activity[]
  proposals   Proposal[]
  conversions ConversionEvent[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([campaignId])
  @@index([email])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

model LeadSource {
  id       String  @id @default(cuid())
  name     String
  channel  Channel
  slug     String  @unique
  isActive Boolean @default(true)

  leads       Lead[]
  conversions ConversionEvent[]
}

enum Channel {
  ORGANIC_SEARCH
  PAID_SEARCH
  SOCIAL_ORGANIC
  SOCIAL_PAID
  DIRECT
  REFERRAL
  EMAIL
  WHATSAPP
  EVENT
  PARTNER
  OTHER
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           ClientType   @default(INDIVIDUAL)
  name           String
  legalName      String?
  taxId          String?
  email          String
  phone          String?
  whatsapp       String?
  address        String?
  city           String?      @default("Luanda")
  country        String       @default("AO")
  notes          String?      @db.Text
  tags           String[]     @default([])
  lifetimeValueMinor Int      @default(0)
  currency       String       @default("AOA")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  users        ClientUser[]
  leads        Lead[]
  bookings     Booking[]
  proposals    Proposal[]
  invoices     Invoice[]
  deliverables Deliverable[]
  documents    Document[]
  saasProjects SaaSProject[]
  activities   Activity[]

  @@unique([organizationId, email])
  @@index([organizationId, name])
  @@index([deletedAt])
}

enum ClientType {
  INDIVIDUAL
  COMPANY
  AGENCY
  PUBLIC_SECTOR
}

// Liga uma conta de utilizador ao(s) cliente(s) que pode ver no portal
model ClientUser {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([clientId, userId])
  @@index([userId])
}

model Proposal {
  id             String         @id @default(cuid())
  organizationId String
  number         String
  clientId       String?
  client         Client?        @relation(fields: [clientId], references: [id])
  leadId         String?
  lead           Lead?          @relation(fields: [leadId], references: [id])
  title          String
  status         ProposalStatus @default(DRAFT)
  version        Int            @default(1)
  currency       String         @default("AOA")
  subtotalMinor  Int
  discountMinor  Int            @default(0)
  taxMinor       Int            @default(0)
  totalMinor     Int
  validUntil     DateTime
  content        Json // itens congelados no envio
  pdfUrl         String?
  sentAt         DateTime?
  viewedAt       DateTime?
  respondedAt    DateTime?
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  bookings Booking[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([clientId])
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  subject   String
  notes     String?      @db.Text
  dueAt     DateTime?
  doneAt    DateTime?
  leadId    String?
  lead      Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@index([leadId])
  @@index([clientId])
  @@index([userId, dueAt])
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  WHATSAPP
  NOTE
  TASK
  SITE_VISIT
}

// =============================================================================
// 3. CATÁLOGO DE SERVIÇOS E PREÇOS
// =============================================================================

model ServiceCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  icon        String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  services Service[]
}

model Service {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String
  category       ServiceCategory @relation(fields: [categoryId], references: [id])
  name           String
  slug           String
  shortDescription String?       @db.Text
  description    String?         @db.Text
  deliveryDays   Int             @default(5)
  durationMinutes Int? // duração da sessão, quando aplicável
  requiresBooking Boolean        @default(true)
  isRecurring    Boolean         @default(false) // pacotes mensais
  isActive       Boolean         @default(true)
  sortOrder      Int             @default(0)
  seoPageId      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  prices        PriceListItem[]
  bookingItems  BookingItem[]
  resourceLinks ServiceResource[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
}

model PriceList {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  currency       String       @default("AOA")
  validFrom      DateTime
  validUntil     DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  items PriceListItem[]

  @@index([organizationId, isActive, validFrom])
}

model PriceListItem {
  id          String    @id @default(cuid())
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  unitAmountMinor Int
  minQuantity Int       @default(1)
  depositPercent Int    @default(50) // % exigida para confirmar reserva
  notes       String?

  @@unique([priceListId, serviceId])
}

model Resource {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           ResourceType
  name           String
  description    String?
  isBookable     Boolean      @default(true)
  isActive       Boolean      @default(true)

  serviceLinks      ServiceResource[]
  bookingResources  BookingResource[]
  availabilityRules AvailabilityRule[]
}

enum ResourceType {
  STUDIO
  PHOTOGRAPHER
  VIDEOGRAPHER
  EDITOR
  DESIGNER
  EQUIPMENT
  VEHICLE
}

model ServiceResource {
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  quantity   Int      @default(1)

  @@id([serviceId, resourceId])
}

model AvailabilityRule {
  id         String    @id @default(cuid())
  resourceId String
  resource   Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  weekday    Int? // 0=domingo ... 6=sábado; null = data específica
  specificDate DateTime?
  startTime  String // "08:00"
  endTime    String // "18:00"
  isBlackout Boolean   @default(false)
  reason     String?

  @@index([resourceId, weekday])
  @@index([resourceId, specificDate])
}

// =============================================================================
// 4. BOOKING & PRODUCTION
// =============================================================================

model Booking {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reference      String // legível: VD-2026-00123
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id])
  proposalId     String?
  proposal       Proposal?     @relation(fields: [proposalId], references: [id])

  // contacto quando a reserva é criada sem conta
  guestName  String?
  guestEmail String?
  guestPhone String?

  status BookingStatus @default(DRAFT)

  scheduledStart DateTime
  scheduledEnd   DateTime
  location       String?
  locationNotes  String?  @db.Text

  currency      String @default("AOA")
  subtotalMinor Int    @default(0)
  discountMinor Int    @default(0)
  taxMinor      Int    @default(0)
  totalMinor    Int    @default(0)
  depositMinor  Int    @default(0) // exigido para confirmar
  paidMinor     Int    @default(0) // derivado do ledger; reconciliado

  holdExpiresAt DateTime? // libertação automática do slot
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?

  internalNotes String? @db.Text
  clientNotes   String? @db.Text
  metadata      Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items        BookingItem[]
  resources    BookingResource[]
  productionJobs ProductionJob[]
  invoices     Invoice[]
  payments     Payment[]
  deliverables Deliverable[]

  @@unique([organizationId, reference])
  @@index([organizationId, status, scheduledStart])
  @@index([clientId, scheduledStart])
  @@index([status, holdExpiresAt])
}

enum BookingStatus {
  DRAFT
  PENDING
  CONFIRMED
  IN_PRODUCTION
  DELIVERED
  CLOSED
  CANCELLED
  EXPIRED
  REFUNDED
}

model BookingItem {
  id              String  @id @default(cuid())
  bookingId       String
  booking         Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service @relation(fields: [serviceId], references: [id])
  description     String
  quantity        Int     @default(1)
  unitAmountMinor Int // congelado no momento da reserva
  totalMinor      Int

  @@index([bookingId])
}

model BookingResource {
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id])

  // Constraint de exclusão criada por migração SQL manual:
  //   ALTER TABLE "BookingResource" ADD CONSTRAINT no_overlap
  //   EXCLUDE USING gist ("resourceId" WITH =, "period" WITH &&)
  //   WHERE (status = 'CONFIRMED');
  periodStart DateTime
  periodEnd   DateTime

  @@id([bookingId, resourceId])
  @@index([resourceId, periodStart, periodEnd])
}

model ProductionJob {
  id           String    @id @default(cuid())
  bookingId    String
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  title        String
  stage        JobStage  @default(PREPARATION)
  assigneeId   String?
  assignee     User?     @relation("JobAssignee", fields: [assigneeId], references: [id])
  checklist    Json      @default("[]")
  startedAt    DateTime?
  completedAt  DateTime?
  dueAt        DateTime?
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([bookingId])
  @@index([assigneeId, stage])
}

enum JobStage {
  PREPARATION
  SHOOTING
  INGEST
  EDITING
  COLOR_GRADING
  SOUND
  REVIEW
  CLIENT_REVIEW
  FINAL_EXPORT
  DELIVERED
}

// =============================================================================
// 5. BILLING & PAYMENTS
// =============================================================================

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String // sequencial certificado: FT VD2026/000123
  series         String        @default("VD2026")
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id])
  bookingId      String?
  booking        Booking?      @relation(fields: [bookingId], references: [id])
  saasProjectId  String?
  saasProject    SaaSProject?  @relation(fields: [saasProjectId], references: [id])

  type   InvoiceType   @default(INVOICE)
  status InvoiceStatus @default(DRAFT)

  currency      String @default("AOA")
  subtotalMinor Int
  discountMinor Int    @default(0)
  taxRate       Int    @default(1400) // basis points: 1400 = 14 % IVA
  taxMinor      Int    @default(0)
  totalMinor    Int
  paidMinor     Int    @default(0)
  dueMinor      Int    @default(0)

  issuedAt DateTime?
  dueAt    DateTime?
  paidAt   DateTime?
  voidedAt DateTime?
  voidReason String?

  pdfUrl  String?
  hashSig String? // encadeamento para integridade documental

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines         InvoiceLine[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]
  creditNotes   Invoice[]     @relation("CreditNoteOf")
  creditNoteOfId String?
  creditNoteOf  Invoice?      @relation("CreditNoteOf", fields: [creditNoteOfId], references: [id])

  @@unique([organizationId, series, number])
  @@index([organizationId, status, dueAt])
  @@index([clientId])
}

enum InvoiceType {
  PROFORMA
  INVOICE
  RECEIPT
  CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

model InvoiceLine {
  id              String  @id @default(cuid())
  invoiceId       String
  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description     String
  quantity        Int     @default(1)
  unitAmountMinor Int
  taxRate         Int     @default(1400)
  totalMinor      Int
  sortOrder       Int     @default(0)

  @@index([invoiceId])
}

model Payment {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String?
  invoice        Invoice?        @relation(fields: [invoiceId], references: [id])
  bookingId      String?
  booking        Booking?        @relation(fields: [bookingId], references: [id])
  clientId       String?

  provider PaymentProvider
  method   PaymentMethodType
  status   PaymentStatus     @default(INITIATED)

  currency      String @default("AOA")
  amountMinor   Int
  feeMinor      Int    @default(0)
  netMinor      Int    @default(0)
  refundedMinor Int    @default(0)
  fxRate        Int? // basis points, quando há conversão

  providerRef     String? // PaymentIntent id / referência GPO
  providerStatus  String?
  idempotencyKey  String?

  initiatedAt DateTime  @default(now())
  capturedAt  DateTime?
  failedAt    DateTime?
  expiresAt   DateTime?
  failureCode String?
  failureMessage String?

  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emisReference EMISPaymentReference?
  mcxTransaction MulticaixaTransaction?
  providerEvents PaymentProviderEvent[]
  ledgerEntries  LedgerEntry[]
  refunds        Refund[]

  @@unique([provider, providerRef])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, initiatedAt])
  @@index([status, expiresAt]) // alvo do job de reconciliação
  @@index([bookingId])
}

enum PaymentProvider {
  STRIPE
  EMIS
  BANK_TRANSFER
  CASH
  INTERNAL_CREDIT
}

enum PaymentMethodType {
  CARD_INTERNATIONAL
  MULTICAIXA_EXPRESS
  MULTICAIXA_REFERENCE
  CARD_LOCAL
  BANK_TRANSFER
  CASH
  CREDIT_NOTE
}

enum PaymentStatus {
  INITIATED
  PENDING
  CAPTURED
  FAILED
  EXPIRED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
  DISPUTED
}

model EMISPaymentReference {
  id         String   @id @default(cuid())
  paymentId  String   @unique
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  reference  String   @unique // referência enviada ao GPO
  frameToken String? // token do iframe (curta duração)
  posId      String?
  entityCode String?
  callbackUrl String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([reference])
}

model MulticaixaTransaction {
  id             String   @id @default(cuid())
  paymentId      String   @unique
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  transactionId  String?  @unique // id atribuído pelo GPO
  terminalId     String?
  mobileNumber   String? // mascarado em logs
  authorizationCode String?
  rawStatus      String?
  confirmedAt    DateTime?
  rawPayload     Json? // payload bruto, imutável
  createdAt      DateTime @default(now())
}

// Registo bruto e imutável de tudo o que chega de um provedor
model PaymentProviderEvent {
  id              String          @id @default(cuid())
  provider        PaymentProvider
  providerEventId String
  eventType       String
  paymentId       String?
  payment         Payment?        @relation(fields: [paymentId], references: [id])
  payload         Json
  signatureValid  Boolean         @default(false)
  sourceIp        String?
  receivedAt      DateTime        @default(now())
  processedAt     DateTime?
  processingError String?
  attempts        Int             @default(0)

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@index([processedAt])
}

// APPEND-ONLY. Sem UPDATE. Sem DELETE.
model LedgerEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  entryType      LedgerEntryType
  direction      LedgerDirection
  currency       String       @default("AOA")
  amountMinor    Int
  invoiceId      String?
  invoice        Invoice?     @relation(fields: [invoiceId], references: [id])
  paymentId      String?
  payment        Payment?     @relation(fields: [paymentId], references: [id])
  refundId       String?
  description    String
  reversalOfId   String? // correção = nova entrada, nunca update
  occurredAt     DateTime     @default(now())
  recordedAt     DateTime     @default(now())
  recordedById   String?
  metadata       Json         @default("{}")

  @@index([organizationId, occurredAt])
  @@index([invoiceId])
  @@index([paymentId])
}

enum LedgerEntryType {
  PAYMENT_RECEIVED
  REFUND_ISSUED
  FEE_CHARGED
  INVOICE_ISSUED
  CREDIT_NOTE
  ADJUSTMENT
  FX_DIFFERENCE
  WRITE_OFF
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

model Refund {
  id           String       @id @default(cuid())
  paymentId    String
  payment      Payment      @relation(fields: [paymentId], references: [id])
  amountMinor  Int
  currency     String       @default("AOA")
  reason       String
  status       RefundStatus @default(REQUESTED)
  providerRef  String?
  requestedById String
  approvedById String?
  requestedAt  DateTime     @default(now())
  processedAt  DateTime?
  notes        String?      @db.Text

  @@index([paymentId, status])
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
}

// Garante que um POST repetido não cria dois efeitos
model IdempotencyRecord {
  id             String   @id @default(cuid())
  organizationId String?
  endpoint       String
  idempotencyKey String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  lockedAt       DateTime @default(now())
  completedAt    DateTime?
  expiresAt      DateTime

  @@unique([endpoint, idempotencyKey])
  @@index([expiresAt])
}

// =============================================================================
// 6. DELIVERY & FILES
