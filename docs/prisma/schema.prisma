  clientId    String?
  status      DataRequestStatus @default(RECEIVED)
  receivedAt  DateTime          @default(now())
  dueAt       DateTime
  completedAt DateTime?
  handledById String?
  notes       String?           @db.Text
  exportKey   String?

  @@index([status, dueAt])
}

enum DataRequestType {
  ACCESS
  RECTIFICATION
  ERASURE
  PORTABILITY
  OBJECTION
}

enum DataRequestStatus {
  RECEIVED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyHash        String    @unique
  prefix         String
  scopes         String[]  @default([])
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdById    String
  createdAt      DateTime  @default(now())

  @@index([organizationId, revokedAt])
}
