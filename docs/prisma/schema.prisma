// APPEND-ONLY. Sem UPDATE. Sem DELETE.
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  actorId        String?
  actor          User?        @relation(fields: [actorId], references: [id])
  actorType      ActorType    @default(USER)
  action         String // booking.confirm, payment.override, file.download
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  reason         String? // obrigatório em overrides financeiros
  ip             String?
  userAgent      String?
  requestId      String?
  severity       AuditSeverity @default(INFO)
  at             DateTime     @default(now())

  @@index([organizationId, at])
  @@index([entityType, entityId])
  @@index([actorId, at])
  @@index([action, at])
}

enum ActorType {
  USER
  SYSTEM
  CRON
  WEBHOOK
  API_KEY
}

enum AuditSeverity {
  INFO
  NOTICE
  WARNING
  CRITICAL
}

// Outbox transacional
model DomainEvent {
  id             String       @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  eventType      String // BookingConfirmed, PaymentCaptured
  aggregateType  String
  aggregateId    String
  payload        Json
  version        Int          @default(1)
  occurredAt     DateTime     @default(now())
  processedAt    DateTime?
  attempts       Int          @default(0)
  lastError      String?
  deadLetteredAt DateTime?

  @@index([processedAt, occurredAt])
  @@index([aggregateType, aggregateId])
}

model DataRequest {
