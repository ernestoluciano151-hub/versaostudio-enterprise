model SaaSProject {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  name           String
  slug           String
  type           ProjectType  @default(WEBSITE)
  stage          ProjectStage @default(DISCOVERY)
  description    String?      @db.Text
  repositoryUrl  String?
  stagingUrl     String?
  productionUrl  String?

  currency       String @default("AOA")
  contractValueMinor Int  @default(0)
  monthlyFeeMinor    Int  @default(0)

  startDate DateTime?
  targetDate DateTime?
  liveDate  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  websites     ClientWebsite[]
  assignments  ProjectAssignment[]
  milestones   Milestone[]
  deployments  Deployment[]
  invoices     Invoice[]
  deliverables Deliverable[]

  @@unique([organizationId, slug])
  @@index([organizationId, stage])
  @@index([clientId])
}

enum ProjectType {
  WEBSITE
  LANDING_PAGE
  ECOMMERCE
  SAAS_APPLICATION
  MOBILE_APP
  INTEGRATION
  MAINTENANCE
}

enum ProjectStage {
  DISCOVERY
  DESIGN
  BUILD
  UAT
  LIVE
  MAINTENANCE
  ARCHIVED
  CANCELLED
}

// Âmbito atribuído para EDITOR (pós-produção) — sem isto não há critério de posse
// para "projetos atribuídos". Ver docs/security/rbac-policy-final.md §5.
model ProjectAssignment {
  id            String      @id @default(cuid())
  saasProjectId String
  saasProject   SaaSProject @relation(fields: [saasProjectId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          String? // função no projeto: "editor", "colorista", "sound"
  assignedAt    DateTime    @default(now())
  assignedById  String

  @@unique([saasProjectId, userId]) // cria índice composto (saasProjectId, userId)
  @@index([saasProjectId, userId])
  @@index([userId])
}

model Milestone {
  id            String    @id @default(cuid())
  saasProjectId String
  saasProject   SaaSProject @relation(fields: [saasProjectId], references: [id], onDelete: Cascade)
  title         String
  description   String?   @db.Text
  dueAt         DateTime?
  completedAt   DateTime?
  paymentTriggerPercent Int? // % do contrato a faturar nesta etapa
  sortOrder     Int       @default(0)

  @@index([saasProjectId])
}

model ClientWebsite {
  id            String       @id @default(cuid())
  saasProjectId String
  saasProject   SaaSProject  @relation(fields: [saasProjectId], references: [id], onDelete: Cascade)
  domain        String       @unique
  hostingProvider String?
  cdnProvider   String?
  sslExpiresAt  DateTime?
  uptimeMonitorUrl String?
  analyticsId   String?
  isLive        Boolean      @default(false)
  notes         String?      @db.Text
  createdAt     DateTime     @default(now())

  domains     DomainManagement[]
  deployments Deployment[]
}

model DomainManagement {
  id              String        @id @default(cuid())
  clientWebsiteId String
  clientWebsite   ClientWebsite @relation(fields: [clientWebsiteId], references: [id], onDelete: Cascade)
  domain          String
  registrar       String?
  registeredAt    DateTime?
  expiresAt       DateTime?
  autoRenew       Boolean       @default(true)
  nameservers     String[]      @default([])
  dnsProvider     String?
  // Credenciais NUNCA em texto claro — apenas referência a cofre externo
  credentialVaultRef String?
  renewalCostMinor Int?
  currency        String        @default("AOA")

  @@index([expiresAt])
}

model Deployment {
  id              String           @id @default(cuid())
  saasProjectId   String
  saasProject     SaaSProject      @relation(fields: [saasProjectId], references: [id], onDelete: Cascade)
  clientWebsiteId String?
  clientWebsite   ClientWebsite?   @relation(fields: [clientWebsiteId], references: [id])
  environment     DeployEnvironment @default(PRODUCTION)
  commitSha       String?
  version         String?
  status          DeployStatus     @default(PENDING)
  triggeredById   String?
  startedAt       DateTime         @default(now())
  finishedAt      DateTime?
  logUrl          String?
  rollbackOfId    String?

  @@index([saasProjectId, startedAt])
}

enum DeployEnvironment {
  PREVIEW
  STAGING
  PRODUCTION
}

enum DeployStatus {
  PENDING
  BUILDING
  SUCCESS
  FAILED
  ROLLED_BACK
}

// =============================================================================
// 9. CONTENT & SEO
// =============================================================================

model SEOPage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slug           String
  locale         String       @default("pt-AO")
  pageType       PageType     @default(LANDING)
  status         PageStatus   @default(DRAFT)

  title          String
  metaTitle      String
  metaDescription String      @db.Text
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?      @db.Text
  ogImageKey     String?
  noindex        Boolean      @default(false)
  jsonLd         Json? // schema.org

  primaryKeyword String?
  h1             String?
  readingTimeMin Int?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  blocks   ContentBlock[]
  versions PageVersion[]
  keywords PageKeyword[]

  @@unique([organizationId, slug, locale])
  @@index([organizationId, status])
  @@index([slug])
}

enum PageType {
  HOME
  SERVICE
  LANDING
  BLOG_POST
  PORTFOLIO
  LEGAL
  ABOUT
  CONTACT
  PRICING
}

enum PageStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

model ContentBlock {
  id        String    @id @default(cuid())
  pageId    String
  page      SEOPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      BlockType
  sortOrder Int       @default(0)
  content   Json
  isVisible Boolean   @default(true)

  @@index([pageId, sortOrder])
}

enum BlockType {
  HERO
  RICH_TEXT
  SERVICE_GRID
  PRICING_TABLE
  GALLERY
  VIDEO
  TESTIMONIALS
  FAQ
  CTA
  STATS
  PROCESS_STEPS
  CONTACT_FORM
  LOGO_CLOUD
}

model PageVersion {
  id          String   @id @default(cuid())
  pageId      String
  page        SEOPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json // página + blocos completos
  changeNote  String?
  publishedBy String?
  createdAt   DateTime @default(now())

  @@unique([pageId, version])
  @@index([pageId, createdAt])
}

model Keyword {
  id            String  @id @default(cuid())
  term          String  @unique
  locale        String  @default("pt-AO")
  searchVolume  Int?
  difficulty    Int?
  intent        SearchIntent @default(INFORMATIONAL)
  currentRank   Int?
  targetRank    Int?
  lastCheckedAt DateTime?

  pages PageKeyword[]
}

enum SearchIntent {
  INFORMATIONAL
  NAVIGATIONAL
  COMMERCIAL
  TRANSACTIONAL
  LOCAL
}

model PageKeyword {
  pageId    String
  page      SEOPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  keywordId String
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  isPrimary Boolean @default(false)

  @@id([pageId, keywordId])
}

model Redirect {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromPath       String
  toPath         String
  statusCode     Int          @default(301)
  isActive       Boolean      @default(true)
  hitCount       Int          @default(0)
  lastHitAt      DateTime?
  reason         String?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, fromPath])
  @@index([fromPath, isActive])
}

// =============================================================================
// 10. NOTIFICATIONS
// =============================================================================

model NotificationTemplate {
  id        String              @id @default(cuid())
  key       String              @unique // booking.confirmed
  channel   NotificationChannel
  locale    String              @default("pt-AO")
  subject   String?
  body      String              @db.Text
  variables String[]            @default([])
  isActive  Boolean             @default(true)
  updatedAt DateTime            @updatedAt

  events NotificationEvent[]
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  SMS
  IN_APP
  PUSH
}

model NotificationEvent {
  id         String              @id @default(cuid())
  templateId String?
  template   NotificationTemplate? @relation(fields: [templateId], references: [id])
  channel    NotificationChannel
  eventType  String
  entityType String?
  entityId   String?
  recipient  String // e-mail ou telefone
  userId     String?
  payload    Json                @default("{}")
  status     NotificationStatus  @default(QUEUED)
  attempts   Int                 @default(0)
  providerId String?
  error      String?
  scheduledFor DateTime?
  sentAt     DateTime?
  deliveredAt DateTime?
  openedAt   DateTime?
  createdAt  DateTime            @default(now())

  @@unique([eventType, entityId, channel]) // idempotência de envio
  @@index([status, scheduledFor])
}

enum NotificationStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  OPENED
  FAILED
  BOUNCED
  SUPPRESSED
}

