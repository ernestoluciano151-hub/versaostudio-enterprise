model Deliverable {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String?
  booking        Booking?          @relation(fields: [bookingId], references: [id])
  saasProjectId  String?
  saasProject    SaaSProject?      @relation(fields: [saasProjectId], references: [id])
  clientId       String
  client         Client            @relation(fields: [clientId], references: [id])
  title          String
  description    String?           @db.Text
  status         DeliverableStatus @default(DRAFT)
  accessType     AccessType        @default(CLIENT_ONLY)
  passwordHash   String?
  publishedAt    DateTime?
  approvedAt     DateTime?
  expiresAt      DateTime?
  purgeAt        DateTime? // política de retenção
  purgedAt       DateTime?
  downloadLimit  Int?
  downloadCount  Int               @default(0)
  revisionCount  Int               @default(0)
  maxRevisions   Int               @default(2)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  files      FileObject[]
  accessLogs FileAccessLog[]

  @@index([organizationId, status])
  @@index([clientId])
  @@index([purgeAt])
}

enum DeliverableStatus {
  DRAFT
  PUBLISHED
  CLIENT_REVIEW
  REVISION_REQUESTED
  APPROVED
  ARCHIVED
  PURGED
}

enum AccessType {
  CLIENT_ONLY
  PASSWORD
  PUBLIC_LINK
}

model FileObject {
  id            String      @id @default(cuid())
  deliverableId String?
  deliverable   Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  bucket        String      @default("versaostudio")
  storageKey    String      @unique
  fileName      String
  mimeType      String
  sizeBytes     BigInt
  checksumSha256 String?
  width         Int?
  height        Int?
  durationSec   Int?
  kind          FileKind    @default(OTHER)
  isPreview     Boolean     @default(false)
  thumbnailKey  String?
  uploadedById  String?
  uploadedAt    DateTime    @default(now())
  deletedAt     DateTime?

  accessLogs FileAccessLog[]

  @@index([deliverableId])
  @@index([deletedAt])
}

enum FileKind {
  PHOTO
  VIDEO
  AUDIO
  DOCUMENT
  DESIGN_SOURCE
  ARCHIVE
  OTHER
}

model FileAccessLog {
  id            String      @id @default(cuid())
  fileId        String?
  file          FileObject? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  deliverableId String?
  deliverable   Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  userId        String?
  action        FileAction
  ip            String?
  userAgent     String?
  bytesServed   BigInt?
  at            DateTime    @default(now())

  @@index([deliverableId, at])
  @@index([userId, at])
}

enum FileAction {
  VIEW
  DOWNLOAD
  PREVIEW
  SHARE_LINK_CREATED
  DELETE
}

model Document {
  id         String       @id @default(cuid())
  clientId   String
  client     Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type       DocumentType
  title      String
  storageKey String
  signedAt   DateTime?
  signedBy   String?
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())

  @@index([clientId, type])
}

enum DocumentType {
  CONTRACT
  IMAGE_RIGHTS_RELEASE
  NDA
  PROPOSAL_PDF
  INVOICE_PDF
  IDENTIFICATION
  OTHER
}

// =============================================================================
// 7. AGENCY & MARKETING
// =============================================================================

model MarketingCampaign {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  objective      CampaignObjective
  status         CampaignStatus @default(DRAFT)
  clientId       String? // campanha para cliente (serviço de agência)
  isInternal     Boolean        @default(true)

  channels  Channel[] @default([])
  audience  String?   @db.Text
  keyMessage String?  @db.Text

  currency      String @default("AOA")
  budgetMinor   Int    @default(0)
  spentMinor    Int    @default(0)
  revenueMinor  Int    @default(0)

  targetLeads       Int?
  targetConversions Int?

  startDate DateTime
  endDate   DateTime?
  launchedAt DateTime?

  utmCampaign String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads       Lead[]
  posts       SocialMediaPost[]
  contentPlans ContentPlan[]
  conversions ConversionEvent[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, startDate])
}

enum CampaignObjective {
  AWARENESS
  TRAFFIC
  LEAD_GENERATION
  CONVERSION
  RETENTION
  RECRUITMENT
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model ContentPlan {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignId     String?
  campaign       MarketingCampaign? @relation(fields: [campaignId], references: [id])
  clientId       String?
  title          String
  month          Int
  year           Int
  status         ContentPlanStatus @default(DRAFT)
  notes          String?      @db.Text
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  posts SocialMediaPost[]

  @@index([organizationId, year, month])
}

enum ContentPlanStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_EXECUTION
  COMPLETED
}

model SocialMediaPost {
  id            String      @id @default(cuid())
  contentPlanId String?
  contentPlan   ContentPlan? @relation(fields: [contentPlanId], references: [id])
  campaignId    String?
  campaign      MarketingCampaign? @relation(fields: [campaignId], references: [id])
  clientId      String?
  platform      SocialPlatform
  format        PostFormat  @default(IMAGE)
  caption       String      @db.Text
  hashtags      String[]    @default([])
  mediaKeys     String[]    @default([])
  status        PostStatus  @default(DRAFT)
  version       Int         @default(1)
  scheduledFor  DateTime?
  publishedAt   DateTime?
  externalId    String?
  externalUrl   String?

  impressions Int @default(0)
  reach       Int @default(0)
  engagements Int @default(0)
  clicks      Int @default(0)
  saves       Int @default(0)
  shares      Int @default(0)

  createdById String
  approvedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([campaignId, scheduledFor])
  @@index([status, scheduledFor])
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  LINKEDIN
  YOUTUBE
  WHATSAPP_STATUS
  X
}

enum PostFormat {
  IMAGE
  CAROUSEL
  REEL
  STORY
  VIDEO
  TEXT
  LIVE
}

enum PostStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
  ARCHIVED
}

model ConversionEvent {
  id             String     @id @default(cuid())
  organizationId String
  type           ConversionType
  value          Int        @default(0) // amountMinor quando aplicável
  currency       String     @default("AOA")
  leadId         String?
  lead           Lead?      @relation(fields: [leadId], references: [id])
  campaignId     String?
  campaign       MarketingCampaign? @relation(fields: [campaignId], references: [id])
  sourceId       String?
  source         LeadSource? @relation(fields: [sourceId], references: [id])
  sessionId      String?
  pagePath       String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  metadata       Json       @default("{}")
  occurredAt     DateTime   @default(now())

  @@index([organizationId, type, occurredAt])
  @@index([campaignId, occurredAt])
}

enum ConversionType {
  PAGE_VIEW
  FORM_SUBMIT
  WHATSAPP_CLICK
  PHONE_CLICK
  BOOKING_STARTED
  BOOKING_CREATED
  BOOKING_CONFIRMED
  PAYMENT_COMPLETED
  PROPOSAL_ACCEPTED
  NEWSLETTER_SIGNUP
}

