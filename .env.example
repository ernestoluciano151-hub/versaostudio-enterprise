# =============================================================================
# VersaoStudio Enterprise — variáveis de ambiente
# Copiar para .env.local (desenvolvimento). NUNCA commitar .env.local.
# Em produção: definir no painel do Vercel, com acesso restrito.
# Validadas por Zod no arranque (lib/env.ts) — a app não arranca se faltar algo.
# =============================================================================

# ---------- Aplicação ----------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.versaodigitallda.com
APP_LOCALE=pt-AO
APP_TIMEZONE=Africa/Luanda
APP_BASE_CURRENCY=AOA

# ---------- Base de dados ----------
# Pooled (PgBouncer) para a app; direta para migrações
DATABASE_URL="postgresql://user:password@host:6543/versaostudio?pgbouncer=true&connection_limit=10"
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/versaostudio"

# ---------- Autenticação (NextAuth v5) ----------
# Gerar: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# OAuth opcional
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Encriptação de segredos MFA at-rest — openssl rand -hex 32
MFA_ENCRYPTION_KEY=

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_DEFAULT_CURRENCY=usd

# ---------- EMIS GPO (Angola) ----------
# Credenciais emitidas pelo banco adquirente. Confirmar nomes exatos na documentação
# fornecida pelo banco antes de implementar.
EMIS_GPO_BASE_URL=https://pagamentonline.emis.co.ao/online-payment-gateway/portal
EMIS_GPO_FRAME_TOKEN=
EMIS_GPO_POS_ID=
EMIS_GPO_ENTITY_CODE=
EMIS_GPO_CALLBACK_URL=https://www.versaodigitallda.com/api/payments/emis/callback
# IPs autorizados a chamar o callback, separados por vírgula (também na WAF Cloudflare)
EMIS_ALLOWED_IPS=
# Segredo partilhado para validação de assinatura, se o adquirente o disponibilizar
EMIS_CALLBACK_SECRET=
# Minutos de validade da sessão de pagamento
EMIS_PAYMENT_TIMEOUT_MINUTES=30
EMIS_REFERENCE_EXPIRY_DAYS=3

# ---------- Armazenamento (Cloudflare R2) ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=versaostudio
R2_PUBLIC_BUCKET_NAME=versaostudio-public
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PRESIGN_UPLOAD_TTL_SECONDS=900
R2_PRESIGN_DOWNLOAD_TTL_SECONDS=300
MAX_UPLOAD_SIZE_MB=2048

# ---------- E-mail (Resend) ----------
RESEND_API_KEY=
EMAIL_FROM="Versão Digital <geral@versaodigitallda.com>"
EMAIL_REPLY_TO=versaodigitallda@gmail.com
EMAIL_BCC_ARCHIVE=

# ---------- WhatsApp ----------
WHATSAPP_BUSINESS_NUMBER=244939183513
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---------- Observabilidade ----------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0.15
LOG_LEVEL=info

# ---------- Analytics ----------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
GOOGLE_SITE_VERIFICATION=

# ---------- Anti-bot (Cloudflare Turnstile) ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Cron ----------
# Autentica /api/cron/* — openssl rand -hex 32
CRON_SECRET=
RECONCILIATION_INTERVAL_MINUTES=5
BOOKING_HOLD_MINUTES=30

# ---------- Rate limiting (Upstash Redis, opcional) ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_ENABLED=true

# ---------- Negócio ----------
DEFAULT_VAT_RATE_BPS=1400        # 14 % em basis points
DEFAULT_DEPOSIT_PERCENT=50
INVOICE_SERIES=VD2026
COMPANY_LEGAL_NAME="Versão Digital LDA"
COMPANY_TAX_ID=
COMPANY_ADDRESS="Rua N2, Casa N55, Bairro Cassenda, Luanda, Angola"
COMPANY_PHONE=+244939183513

# ---------- Feature flags ----------
FEATURE_STRIPE_ENABLED=true
FEATURE_EMIS_ENABLED=true
FEATURE_BLOG_ENABLED=true
FEATURE_CLIENT_PORTAL_ENABLED=true
FEATURE_MAINTENANCE_MODE=false
